<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Either_Phone_or_Email_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK( Email__c )  &amp;&amp;  ISBLANK( Phone__c )</errorConditionFormula>
    <errorMessage>Enter either email or phone to save the record.</errorMessage>
</ValidationRule>
