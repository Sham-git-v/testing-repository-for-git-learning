<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <description>A dynamic datatable component that displays data based on a configured Field Set.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage, lightning__HomePage, lightning__RecordPage">
            <property name="cardTitle" type="String" label="Card Title" default="Dynamic Datatable"/>
            <property name="objectApiName" type="String" label="Object API Name" required="true" placeholder="e.g., Contact"/>
            <property name="fieldSetName" type="String" label="Field Set Name" required="true" placeholder="e.g., My_Field_Set_Name"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>